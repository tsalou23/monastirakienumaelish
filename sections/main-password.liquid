<div class="interior" style="position:relative;opacity:1;min-height:100vh">
  <span class="mono amber" style="font-size:12px">{{ 'general.password_page.soon' | t }}</span>
  <span class="big">{{ 'general.password_page.opens_soon_html' | t }}</span>
  {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    <div class="f-in" style="width:min(420px,90vw)"><input class="inp" type="password" name="password" placeholder="{{ 'general.password_page.password' | t }}" aria-label="{{ 'general.password_page.password' | t }}"><button class="btn btn-y" type="submit">{{ 'general.password_page.enter' | t }}</button></div>
    {%- if form.errors -%}<p class="err">{{ 'general.password_page.wrong' | t }}</p>{%- endif -%}
  {%- endform -%}
</div>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}

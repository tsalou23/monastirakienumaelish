<div class="page-wrap cart-page">
  <h1>{{ 'cart.title' | t }} <span class="mono muted" style="font-size:14px;letter-spacing:.06em">{{ 'cart.title_sub' | t }}</span></h1>
  {%- if cart.item_count == 0 -%}
    <div style="padding:24px 0;display:flex;flex-direction:column;gap:16px">
      <span style="font-size:28px;font-weight:900;letter-spacing:-.03em">{{ 'cart.empty_title' | t }}</span>
      <span class="muted" style="font-size:15px">{{ 'cart.empty_text' | t }}</span>
      <a class="btn btn-y" href="{{ routes.root_url }}#shop" style="align-self:flex-start">{{ 'cart.back_to_rail' | t }}</a>
    </div>
  {%- else -%}
  <form action="{{ routes.cart_url }}" method="post" style="max-width:820px">
    {%- for item in cart.items -%}
      <div class="line">
        <div class="th">{% render 'garment', product: item.product %}</div>
        <div style="display:flex;flex-direction:column;gap:8px">
          <div style="display:flex;justify-content:space-between;gap:12px"><a href="{{ item.url }}" style="font-size:17px;font-weight:800;text-decoration:none">{{ item.product.title }}</a><span class="price">{{ item.final_line_price | money }}</span></div>
          <span class="mono muted" style="font-size:10.5px">{% unless item.product.has_only_default_variant %}{{ 'cart.size' | t }} {{ item.variant.title }} · {% endunless %}{{ item.final_price | money }}</span>
          <div style="display:flex;align-items:center;gap:16px">
            <label class="mono muted" style="font-size:10.5px" for="q-{{ forloop.index }}">{{ 'cart.qty' | t }}</label>
            <input id="q-{{ forloop.index }}" class="inp" style="flex:none;width:80px;height:44px;border-right:1px solid #2A2C27" type="number" min="0" name="updates[]" value="{{ item.quantity }}">
            <a class="rm" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
          </div>
        </div>
      </div>
    {%- endfor -%}
    <div class="d-foot" style="padding:24px 0;border-top:0">
      <div style="display:flex;justify-content:space-between;align-items:baseline"><span class="mono muted" style="font-size:11px">{{ 'cart.subtotal' | t }}</span><span class="price" style="font-size:20px">{{ cart.total_price | money }}</span></div>
      <span class="muted" style="font-size:13px">{{ 'cart.shipping_note' | t }}</span>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <button class="btn btn-l" type="submit" name="update">{{ 'cart.update' | t }}</button>
        <button class="btn btn-y" type="submit" name="checkout" style="flex:1">{{ 'cart.checkout' | t }} — {{ cart.total_price | money }}</button>
      </div>
    </div>
  </form>
  {%- endif -%}
</div>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}

{%- comment -%} Usage: {% render 'product-grid', products: col.products, limit: 24, title: 'Collection', show_tile: true %} {%- endcomment -%}
{%- assign types = '' -%}
{%- assign shown = 0 -%}
{%- for p in products limit: limit -%}
  {%- assign t = p.type | upcase -%}
  {%- if t != blank -%}{%- unless types contains t -%}{%- assign types = types | append: t | append: '|' -%}{%- endunless -%}{%- endif -%}
  {%- assign shown = shown | plus: 1 -%}
{%- endfor -%}
{%- assign types = types | split: '|' -%}
<section id="collection" class="coll" data-st="ΣΥΛΛΟΓΗ|COLLECTION|コレクション" aria-label="Collection">
  <div class="g-wrap">
    <div class="g-head">
      <h2 class="rv" data-rv>{{ title }}</h2>
      <div class="meta mono rv" data-rv><span>ΣΥΛΛΟΓΗ · コレクション · FW26</span><span style="color:#ECE9E1"><span data-grid-count>{{ shown }}</span> PIECES ON THIS LINE</span></div>
    </div>
    {%- if types.size > 1 -%}
    <div class="chips" role="group" aria-label="Filter by category">
      <button class="chip on" data-filter="ALL" aria-pressed="true">ALL <small class="jp">ΟΛΑ · 全て</small></button>
      {%- for t in types -%}
        {%- case t -%}
          {%- when 'HOODIES' -%}{%- assign sub = 'ΦΟΥΤΕΡ · パーカー' -%}
          {%- when 'OUTER' -%}{%- assign sub = 'ΕΞΩΤΕΡΙΚΑ · アウター' -%}
          {%- when 'TEES' -%}{%- assign sub = 'ΜΠΛΟΥΖΕΣ · Tシャツ' -%}
          {%- when 'BOTTOMS' -%}{%- assign sub = 'ΠΑΝΤΕΛΟΝΙΑ · ボトムス' -%}
          {%- else -%}{%- assign sub = '' -%}
        {%- endcase -%}
        <button class="chip" data-filter="{{ t | escape }}" aria-pressed="false">{{ t }} {% if sub != '' %}<small class="jp">{{ sub }}</small>{% endif %}</button>
      {%- endfor -%}
    </div>
    {%- endif -%}
    <div class="grid" data-grid>
      {%- for p in products limit: limit -%}
        {%- assign t = p.type | upcase -%}
        {%- case t -%}
          {%- when 'HOODIES' -%}{%- assign tjp = 'パーカー' -%}
          {%- when 'OUTER' -%}{%- assign tjp = 'アウター' -%}
          {%- when 'TEES' -%}{%- assign tjp = 'Tシャツ' -%}
          {%- when 'BOTTOMS' -%}{%- assign tjp = 'ボトムス' -%}
          {%- else -%}{%- assign tjp = '' -%}
        {%- endcase -%}
        <article class="card{% if forloop.first %} feat{% endif %}" data-cat="{{ t | escape }}">
          <div class="cm">
            {%- if forloop.first -%}<img class="cm-bg" src="{{ 'photo-1050.jpg' | asset_url }}" width="1200" height="1600" alt="" loading="lazy">{%- endif -%}
            {%- if t != blank -%}<span class="badge mono">{{ t }}{% if tjp != '' %} · {{ tjp }}{% endif %}</span>{%- endif -%}
            <a class="cm-open" href="{{ p.url }}" data-open="{{ p.id }}" aria-label="Quick view {{ p.title | escape }}"><span class="cm-g"><span class="gsw">{% render 'garment', product: p %}</span></span></a>
            <div class="qa"><span class="mono qa-l">QUICK ADD</span><div class="qa-s">
              {%- for v in p.variants limit: 6 -%}
                <button class="qs" data-add="{{ v.id }}" data-label="{{ p.title | escape }} · {{ v.title | escape }}" {% unless v.available %}disabled style="opacity:.35"{% endunless %} aria-label="Add {{ v.title | escape }} to cart">{{ v.title | split: ' / ' | first }}</button>
              {%- endfor -%}
            </div></div>
          </div>
          <div class="ci">
            <div><span class="mono muted" style="font-size:10.5px">{{ p.metafields.custom.code }}</span><h3>{{ p.title }}</h3><span class="muted" style="font-size:11.5px"><span class="jp">{{ p.metafields.custom.name_jp }}</span>{% if p.metafields.custom.name_gr %} · {{ p.metafields.custom.name_gr }}{% endif %}</span></div>
            <div class="ci-r"><span class="price">{{ p.price | money_without_trailing_zeros }}</span><a class="qv" href="{{ p.url }}" data-open="{{ p.id }}">QUICK VIEW</a></div>
          </div>
        </article>
      {%- else -%}
        <div class="gtile"><span class="t">No pieces on this line yet.</span></div>
      {%- endfor -%}
      {%- if show_tile and shown > 0 -%}
      <div class="gtile" data-tile>
        <span class="mono" style="font-size:11px">DROP 01 · ΤΕΛΕΥΤΑΙΟ ΔΡΟΜΟΛΟΓΙΟ</span>
        <span class="t">終電<br>Last train.<br>{{ shown }} pieces.</span>
        <a href="{{ routes.root_url }}#shop">BACK TO THE RAIL ↑</a>
      </div>
      {%- endif -%}
    </div>
  </div>
</section>

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="theme-color" content="#0D0E0C">
  <link rel="canonical" href="{{ canonical_url }}">
  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
  {%- if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Commissioner:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+JP:wght@400;700;900&display=swap">
  {{ 'enuma.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
<div class="root" id="ee-root" style="min-height:100vh;background-color:#0D0E0C">
  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {%- comment -%} Product overlay (filled by enuma.js) {%- endcomment -%}
  <div class="ov" id="ee-ov" role="dialog" aria-modal="true" aria-label="Product" hidden>
    <div class="ov-bg"><img src="{{ 'photo-1050.jpg' | asset_url }}" width="1200" height="1600" alt=""></div>
    <button class="ov-scrim" data-ov-close aria-label="Close product view"></button>
    <div class="ov-in">
      <div class="ov-fig">
        <span class="ov-jp jp vt" data-f="jp"></span>
        <div class="ov-g" data-f="g"></div>
        <span class="ov-code mono" data-f="codeline"></span>
      </div>
      <div class="ov-panel">
        <span class="mono amber" style="font-size:11px" data-f="kicker"></span>
        <div style="display:flex;flex-direction:column;gap:10px"><h2 data-f="name"></h2><span class="gr" data-f="sub"></span></div>
        <span class="ov-price" data-f="price"></span>
        <p class="ov-desc" data-f="desc"></p>
        <div style="display:flex;flex-direction:column;gap:10px">
          <div style="display:flex;justify-content:space-between" class="mono"><span style="font-size:11px">ΜΕΓΕΘΟΣ · SIZE · サイズ</span><span class="muted" style="font-size:11px">OVERSIZED FIT</span></div>
          <div class="szs" role="group" aria-label="Choose a size" data-f="sizes"></div>
          <p class="err" role="alert" data-f="err" hidden>Choose a size first · Διάλεξε μέγεθος · サイズを選択</p>
        </div>
        <button class="btn btn-y" data-f="add" style="height:60px;width:100%"></button>
        <button class="btn btn-l" data-cart-open style="width:100%"><span>VIEW CART (<span data-cart-count>{{ cart.item_count }}</span>)</span></button>
        <a class="mono muted" data-f="link" style="font-size:11px">FULL PRODUCT PAGE →</a>
        <dl class="specs" data-f="specs"></dl>
      </div>
    </div>
    <button class="close" data-ov-close><span>ΚΛΕΙΣΙΜΟ · CLOSE · 閉じる</span><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2"/></svg></button>
  </div>

  {%- comment -%} Cart drawer {%- endcomment -%}
  <button class="scrim" id="ee-scrim" data-cart-close aria-label="Close cart" hidden></button>
  <aside class="drawer" id="ee-drawer" role="dialog" aria-modal="true" aria-label="Cart" hidden>
    <div class="d-head"><span style="display:flex;flex-direction:column;gap:4px"><b style="font-size:20px;font-weight:900">Cart (<span data-cart-count>{{ cart.item_count }}</span>)</b><small class="mono muted" style="font-size:10.5px">ΚΑΛΑΘΙ · カート</small></span><button class="close" style="position:static" data-cart-close><span>CLOSE</span><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="2"/></svg></button></div>
    <div class="d-body" id="ee-lines"></div>
    <div class="d-foot" id="ee-dfoot" hidden>
      <div style="display:flex;justify-content:space-between;align-items:baseline"><span class="mono muted" style="font-size:11px">SUBTOTAL · ΣΥΝΟΛΟ · 小計</span><span class="price" style="font-size:20px" data-cart-total></span></div>
      <span class="muted" style="font-size:13px">Shipping and taxes calculated at checkout.</span>
      <a class="btn btn-y" href="/checkout" style="width:100%;height:60px"><span>CHECKOUT — <span data-cart-total></span></span></a>
      <a class="mono muted" href="{{ routes.cart_url }}" style="font-size:11px;text-align:center">VIEW FULL CART</a>
    </div>
  </aside>

  <div class="toast" id="ee-toast" role="status" hidden><span data-toast></span><button class="btn btn-d" style="height:40px;padding:0 14px;font-size:11px" data-cart-open>VIEW CART</button></div>
</div>

{%- comment -%} Product data for overlay, quick add and cart thumbnails {%- endcomment -%}
<div hidden aria-hidden="true">
  {%- for p in collections.all.products limit: 50 -%}
    <template data-g="{{ p.id }}">{% render 'garment', product: p %}</template>
    <template data-gf="{{ p.id }}">{% render 'product-photo', product: p, view: 'front', cls: 'g-img' %}</template>
  {%- endfor -%}
</div>
<script>
  window.EE = {
    moneyFormat: {{ shop.money_format | json }},
    routes: { add: {{ routes.cart_add_url | append: '.js' | json }}, change: {{ routes.cart_change_url | append: '.js' | json }}, cart: {{ routes.cart_url | append: '.js' | json }} },
    frames: [{%- for i in (1..276) -%}{%- assign n = i | prepend: '00' | slice: -3, 3 -%}{{ 'hero-f' | append: n | append: '.webp' | asset_url | json }}{% unless forloop.last %},{% endunless %}{%- endfor -%}],
    products: [{%- for p in collections.all.products limit: 50 -%}{% render 'product-json', product: p %}{% unless forloop.last %},{% endunless %}{%- endfor -%}]
  };
</script>
<script src="{{ 'enuma.js' | asset_url }}" defer></script>
</body>
</html>

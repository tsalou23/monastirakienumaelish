<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ 'commissioner-latin.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% render 'fonts' %}
  {{ 'enuma.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body><div class="root">{{ content_for_layout }}</div></body>
</html>

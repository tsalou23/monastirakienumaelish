{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex">
  <title>{{ 'gift_card.title' | t }} — {{ shop.name }}</title>
  {% render 'fonts' %}
  {{ 'enuma.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
  {{ content_for_header }}
  <style>
    .gc{max-width:560px;margin:0 auto;padding:64px 20px;display:flex;flex-direction:column;gap:24px}
    .gc-card{background:var(--c-amber);color:var(--c-bg);padding:28px;display:flex;flex-direction:column;gap:18px;background-image:radial-gradient(circle,var(--c-amber-dot) 2.4px,transparent 2.8px);background-size:14px 14px}
    .gc-bal{font:900 56px/1 var(--f-sans);letter-spacing:-.04em}
    .gc-code{font:700 20px/1.2 var(--f-mono);letter-spacing:.12em;background:var(--c-bg);color:var(--c-ink);padding:14px 16px;word-break:break-all}
    .gc-qr{background:#fff;padding:12px;align-self:flex-start}
    .gc-qr img,.gc-qr canvas{display:block;width:120px;height:120px}
    @media print{.gc .btn{display:none}}
  </style>
</head>
<body>
<main class="gc">
  <span class="mono amber" style="font-size:12px">{{ shop.name | upcase }} · 終電 · ΔΩΡΟΚΑΡΤΑ</span>
  <h1 style="margin:0;font-size:clamp(40px,8vw,72px);font-weight:900;letter-spacing:-.05em;line-height:.9">{{ 'gift_card.title' | t }}</h1>

  {%- if gift_card.expired -%}
    <p class="err">{{ 'gift_card.expired' | t }}</p>
  {%- elsif gift_card.enabled == false -%}
    <p class="err">{{ 'gift_card.disabled' | t }}</p>
  {%- endif -%}

  <div class="gc-card">
    <span class="mono" style="font-size:11px">{{ 'gift_card.balance' | t | upcase }}</span>
    <span class="gc-bal">{{ gift_card.balance | money }}</span>
    {%- if gift_card.expires_on -%}
      {%- assign exp = gift_card.expires_on | date: '%d/%m/%Y' -%}
      <span class="mono" style="font-size:11px">{{ 'gift_card.expires' | t: date: exp }}</span>
    {%- endif -%}
  </div>

  <div style="display:flex;flex-direction:column;gap:10px">
    <span class="mono muted" style="font-size:11px">{{ 'gift_card.code' | t | upcase }}</span>
    <span class="gc-code" id="gc-code">{{ gift_card.code | format_code }}</span>
  </div>

  <div class="gc-qr" id="gc-qr" data-identifier="{{ gift_card.qr_identifier }}" aria-hidden="true"></div>

  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <button class="btn btn-l" type="button" id="gc-copy" data-copied="{{ 'gift_card.copied' | t }}">{{ 'gift_card.copy' | t }}</button>
    <a class="btn btn-y" href="{{ shop.url }}">{{ 'gift_card.shop' | t }}</a>
    <button class="btn btn-d" type="button" onclick="window.print()" style="border:1px solid var(--c-line-3)">{{ 'gift_card.print' | t }}</button>
  </div>
  {%- if gift_card.pass_url -%}
    <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="{{ 'gift_card.wallet' | t }}" loading="lazy"></a>
  {%- endif -%}
</main>
<script>
  window.addEventListener('DOMContentLoaded', function () {
    var qr = document.getElementById('gc-qr');
    if (qr && window.QRCode) new QRCode(qr, { text: qr.getAttribute('data-identifier'), width: 120, height: 120 });
    var b = document.getElementById('gc-copy');
    if (b && navigator.clipboard) b.addEventListener('click', function () {
      navigator.clipboard.writeText(document.getElementById('gc-code').textContent.trim()).then(function () { b.textContent = b.getAttribute('data-copied'); });
    });
  });
</script>
</body>
</html>

{%- assign home = routes.root_url -%}
<header class="nav" id="ee-nav" data-solid="{% if template.name == 'index' %}0{% else %}1{% endif %}">
  <a class="logo" href="{{ home }}#top" aria-label="{{ shop.name | escape }}, {{ 'general.back_to_top' | t }}">
    <span class="lb lb-y">{{ section.settings.badge }}</span>
    <span style="display:flex;flex-direction:column;gap:3px"><b>{{ section.settings.brand }}</b><small class="jp">{{ section.settings.brand_sub }}</small></span>
  </a>
  <div class="nst mono" aria-live="polite"><span class="dot"></span><span>{{ 'general.next_stop' | t }}</span><strong id="ee-st"></strong></div>
  <nav class="nl" aria-label="Main">
    <a href="{{ home }}#shop">{{ 'general.shop' | t }}</a>
    <a href="{{ home }}#collection">{{ 'general.collection' | t }}</a>
    <a href="{{ home }}#about">{{ 'general.about' | t }}</a>
  </nav>
  <div style="display:flex;gap:8px;align-items:center">
    <button class="menub" id="ee-menub" aria-expanded="false">{{ 'general.menu' | t }}</button>
    <a class="cartb" href="{{ routes.cart_url }}" data-cart-open aria-label="{{ 'general.open_cart' | t }}">
      <span>{{ 'general.cart' | t }}</span><span class="cnt" data-cart-count>{{ cart.item_count }}</span>
    </a>
  </div>
</header>
<nav class="mmenu" id="ee-mmenu" aria-label="Mobile" hidden>
  <a href="{{ home }}#shop">Shop <small class="jp muted" style="font-size:13px">ΚΑΤΑΣΤΗΜΑ · ショップ</small></a>
  <a href="{{ home }}#collection">Collection <small class="jp muted" style="font-size:13px">ΣΥΛΛΟΓΗ · コレクション</small></a>
  <a href="{{ home }}#about">About <small class="jp muted" style="font-size:13px">ΠΟΙΟΙ · ブランド</small></a>
</nav>
{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "badge", "label": "Line badge", "default": "E1" },
    { "type": "text", "id": "brand", "label": "Brand name", "default": "ENUMA ELISH" },
    { "type": "text", "id": "brand_sub", "label": "Brand subline", "default": "エヌマ・エリシュ · ΕΝΟΥΜΑ ΕΛΙΣ" }
  ]
}
{% endschema %}

{%- assign s = section.settings -%}
<section id="about" class="camp" data-st="ΜΟΝΑΣΤΗΡΑΚΙ|CAMPAIGN|キャンペーン" aria-label="Campaign">
  <span class="c-jp jp vt rv" data-rv>足元にご注意ください</span>
  <div class="c-wrap">
    <div class="c-top">
      <div class="c-kick mono rv" data-rv><span>CAMPAIGN FW26 · ΚΑΜΠΑΝΙΑ · キャンペーン</span><span style="color:#55534D">SHOT ON THE PLATFORM, AFTER THE LAST TRAIN</span></div>
      <h2 class="c-h"><span class="ln gr rv" data-rv>Προσοχή</span><span class="ln gr rv" data-rv>στο κενό.</span><span class="ln en rv" data-rv>Mind the gap.</span></h2>
    </div>
    <div class="c-grid">
      <figure class="c-a" style="margin:0">
        <div class="ph rvx" data-rv>{% render 'campaign-img', img: s.img1, fallback: 'photo-1051.jpg', par: '-0.08', alt: 'An empty Athens metro platform: green iron columns, sodium light along the far wall, grey tiles and the tactile strip' %}</div>
        <figcaption class="cap mono"><span>FIG. 01 — ΓΡΑΜΜΗ 1, ΑΘΗΝΑ</span><span>THE PLATFORM / ホーム</span></figcaption>
      </figure>
      <figure class="c-b" style="margin:0">
        <div class="ph rvx" data-rv>{% render 'campaign-img', img: s.img2, fallback: 'photo-1054.jpg', par: '0.06', alt: 'The yellow tactile strip at the platform edge, stamped with the word ΠΡΟΣΟΧΗ' %}</div>
        <figcaption class="cap mono"><span>FIG. 02 — ΠΡΟΣΟΧΗ</span><span>注意</span></figcaption>
      </figure>
      <div class="c-copy">
        <p class="lead rv" data-rv>{{ s.lead }}</p>
        <p class="rv" data-rv>{{ s.p1 }}</p>
        <p class="rv" data-rv>{{ s.p2 }}</p>
      </div>
    </div>
  </div>
  <div class="band">
    {% render 'campaign-img', img: s.img3, fallback: 'photo-1052.jpg', par: '0.1', alt: 'A green iron column in front of the track, sodium light glowing along the platform wall' %}
    <div class="band-t">
      <div class="row"><span class="mono" style="font-size:11px">FIG. 03 — 23:58 · ΤΕΛΕΥΤΑΙΑ ΑΝΑΧΩΡΗΣΗ</span><span class="mono" style="font-size:11px">ATHENS ⇄ TOKYO · 9,560 KM</span></div>
      <div class="row"><h3 class="h rv" data-rv>{{ s.band_title }}</h3><span class="band-jp jp vt rv" data-rv>終電</span></div>
    </div>
  </div>
  <div class="c-wrap" style="padding-top:0">
    <div class="c-pair">
      <figure class="c-c" style="margin:0">
        <div class="ph rvx" data-rv>{% render 'campaign-img', img: s.img4, fallback: 'photo-1049.jpg', par: '-0.06', alt: 'A platform column and the escalators at the far end of the station' %}</div>
        <figcaption class="cap mono"><span>FIG. 04 — ΚΥΛΙΟΜΕΝΕΣ</span><span>エスカレーター</span></figcaption>
      </figure>
      <div class="c-d">
        <p class="c-q rv" data-rv>“{{ s.quote }}”<small class="mono">ΚΑΝΟΝΑΣ 01 · RULE 01 · 規則一</small></p>
        <figure style="margin:48px 0 0">
          <div class="ph rvx" data-rv>{% render 'campaign-img', img: s.img5, fallback: 'photo-1053.jpg', par: '0.07', alt: 'Close view of an iron column base on the tiled platform, the track and lit wall behind' %}</div>
          <figcaption class="cap mono"><span>FIG. 05 — ΚΟΛΩΝΑ</span><span>柱</span></figcaption>
        </figure>
        <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:40px">
          <a class="btn btn-d" href="#shop">SHOP THE DROP <svg width="18" height="12" viewBox="0 0 18 12" fill="none" aria-hidden="true"><path d="M1 6h15M11 1l5 5-5 5" stroke="currentColor" stroke-width="2"/></svg></a>
        </div>
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Campaign",
  "settings": [
    { "type": "image_picker", "id": "img1", "label": "Fig. 01 (platform)" },
    { "type": "image_picker", "id": "img2", "label": "Fig. 02 (tactile strip)" },
    { "type": "image_picker", "id": "img3", "label": "Fig. 03 (full-width band)" },
    { "type": "image_picker", "id": "img4", "label": "Fig. 04 (escalators)" },
    { "type": "image_picker", "id": "img5", "label": "Fig. 05 (column)" },
    { "type": "text", "id": "lead", "label": "Lead", "default": "Athens gave us the platform. Tokyo gave us the patience." },
    { "type": "textarea", "id": "p1", "label": "Paragraph 1", "default": "Green iron columns, a ceiling the colour of old cream, one sodium tube running the length of the wall, and a yellow line nobody crosses. Enuma Elish was drawn here, between the last announcement and the last train." },
    { "type": "textarea", "id": "p2", "label": "Paragraph 2", "default": "From Tokyo we took the quiet: the bow before the doors, the station that apologises for your wait, the discipline of a cut that says nothing it doesn't need to." },
    { "type": "text", "id": "band_title", "label": "Band title", "default": "Two cities. One last train." },
    { "type": "text", "id": "quote", "label": "Quote", "default": "Stand behind the yellow line. Wait for the doors. Then go." }
  ],
  "presets": [{ "name": "Campaign" }]
}
{% endschema %}

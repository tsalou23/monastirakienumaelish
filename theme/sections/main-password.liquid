<div class="interior" style="position:relative;opacity:1;min-height:100vh">
  <span class="mono amber" style="font-size:12px">ΣΥΝΤΟΜΑ · SOON · まもなく</span>
  <span class="big">The platform<br>opens soon.</span>
  {%- if shop.password_message != blank -%}<p class="muted">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    <div class="f-in" style="width:min(420px,90vw)"><input class="inp" type="password" name="password" placeholder="Password" aria-label="Password"><button class="btn btn-y" type="submit">ENTER</button></div>
    {%- if form.errors -%}<p class="err">Wrong password.</p>{%- endif -%}
  {%- endform -%}
</div>
{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}

{%- comment -%}
  Garment-on-hanger illustration (placeholder until real product photography).
  Usage: {% render 'garment', product: product %}
  Real product images win: if the product has a featured image and no illustration is mapped, the image is shown.
  Illustration colours are looked up by product handle; unknown handles fall back by product type.
{%- endcomment -%}
{%- liquid
  assign kind = ''
  case product.handle
    when 'last-train-hoodie'
      assign kind = 'hoodie'
      assign c = '#1C1D1B'
      assign c2 = '#121311'
      assign trim = '#E8E5DC'
      assign seam = 'rgba(255,255,255,.09)'
      assign ink = '#F2B705'
      assign print = '終電'
      assign fs = 34
      assign ls = 8
    when 'mind-the-gap-hoodie'
      assign kind = 'hoodie'
      assign c = '#8C8B84'
      assign c2 = '#76756F'
      assign trim = '#1C1D1B'
      assign seam = 'rgba(0,0,0,.22)'
      assign ink = '#F2B705'
      assign print = 'ΠΡΟΣΟΧΗ'
      assign fs = 19
      assign ls = 5
    when 'line-1-zip-up'
      assign kind = 'zip'
      assign c = '#24342A'
      assign c2 = '#1A261F'
      assign trim = '#D8D4C8'
      assign seam = 'rgba(255,255,255,.10)'
      assign ink = '#D8D4C8'
      assign print = 'ΓΡ. 1'
      assign fs = 16
      assign ls = 4
    when 'sodium-coach-jacket'
      assign kind = 'jacket'
      assign c = '#E0A806'
      assign c2 = '#C08F04'
      assign trim = '#1C1D1B'
      assign seam = 'rgba(0,0,0,.25)'
      assign ink = '#1C1D1B'
      assign print = 'ENUMA'
      assign fs = 20
      assign ls = 6
    when 'platform-tee'
      assign kind = 'tee'
      assign c = '#E6E3DA'
      assign c2 = '#D2CFC5'
      assign trim = '#1C1D1B'
      assign seam = 'rgba(0,0,0,.14)'
      assign ink = '#1C1D1B'
      assign print = 'ΑΠΟΒΑΘΡΑ 1'
      assign fs = 13
      assign ls = 3
    when 'underground-tee'
      assign kind = 'tee'
      assign c = '#1C1D1B'
      assign c2 = '#141513'
      assign trim = '#E8E5DC'
      assign seam = 'rgba(255,255,255,.09)'
      assign ink = '#E8E5DC'
      assign print = '地下'
      assign fs = 36
      assign ls = 8
    when 'night-shift-cargo'
      assign kind = 'pants'
      assign c = '#20211F'
      assign c2 = '#171816'
      assign trim = '#F2B705'
      assign seam = 'rgba(255,255,255,.10)'
      assign ink = '#F2B705'
      assign print = 'E1'
      assign fs = 14
      assign ls = 2
    when 'concrete-cargo'
      assign kind = 'pants'
      assign c = '#A8A497'
      assign c2 = '#959185'
      assign trim = '#1C1D1B'
      assign seam = 'rgba(0,0,0,.2)'
      assign ink = '#1C1D1B'
      assign print = 'E1'
      assign fs = 14
      assign ls = 2
  endcase

  if kind == '' and product.featured_image
    assign kind = 'image'
  endif

  if kind == ''
    assign t = product.type | downcase
    assign c = '#1C1D1B'
    assign c2 = '#121311'
    assign trim = '#E8E5DC'
    assign seam = 'rgba(255,255,255,.09)'
    assign ink = '#F2B705'
    assign print = 'E1'
    assign fs = 20
    assign ls = 4
    case t
      when 'tees', 'tee', 't-shirts'
        assign kind = 'tee'
      when 'bottoms', 'pants', 'cargo'
        assign kind = 'pants'
      when 'outer', 'jackets', 'outerwear'
        assign kind = 'jacket'
      else
        assign kind = 'hoodie'
    endcase
  endif
-%}
{%- case kind -%}
{%- when 'image' -%}
{{ product.featured_image | image_url: width: 900 | image_tag: class: 'g-img', alt: product.title, loading: 'lazy' }}

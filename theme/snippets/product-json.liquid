{%- liquid
  assign size_index = 0
  for opt in product.options_with_values
    assign on = opt.name | downcase
    if on == 'size' or on == 'μέγεθος' or on == 'サイズ'
      assign size_index = forloop.index0
    endif
  endfor
-%}
{
  "id": {{ product.id }},
  "handle": {{ product.handle | json }},
  "url": {{ product.url | json }},
  "name": {{ product.title | json }},
  "price": {{ product.price }},
  "available": {{ product.available | json }},
  "code": {{ product.metafields.custom.code.value | default: product.metafields.custom.code | default: '' | json }},
  "jp": {{ product.metafields.custom.name_jp.value | default: product.metafields.custom.name_jp | default: '' | json }},
  "gr": {{ product.metafields.custom.name_gr.value | default: product.metafields.custom.name_gr | default: '' | json }},
  "cat": {{ product.type | upcase | json }},
  "desc": {{ product.description | strip_html | strip | truncate: 400 | json }},
  "fabric": {{ product.metafields.custom.fabric.value | default: product.metafields.custom.fabric | default: '' | json }},
  "fit": {{ product.metafields.custom.fit.value | default: product.metafields.custom.fit | default: '' | json }},
  "colour": {{ product.metafields.custom.colour.value | default: product.metafields.custom.colour | default: '' | json }},
  "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %},
  "variants": [{% for v in product.variants %}{"id": {{ v.id }}, "size": {{ v.options[size_index] | default: v.title | json }}, "available": {{ v.available | json }}, "price": {{ v.price }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
}
